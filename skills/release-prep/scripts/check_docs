#!/bin/sh

set -eu

usage() {
    cat <<'EOF'
Usage: check_docs [--root PATH]

Build Rust documentation with missing_docs denied.

Options:
  --root PATH  Crate or workspace directory (default: cwd)
  -h, --help   Show this help and exit
EOF
}

root=.
while [ "$#" -gt 0 ]; do
    case "$1" in
        --root)
            [ "$#" -ge 2 ] || { echo "Error: --root requires a path" >&2; usage >&2; exit 2; }
            root=$2
            shift 2
            ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Error: unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
done

[ -d "$root" ] || { echo "Error: root is not a directory: $root" >&2; exit 2; }
cd "$root"
echo "Checking for missing documentation..." >&2
RUSTDOCFLAGS="-D missing_docs" cargo doc --no-deps --all-features
echo "All public items are documented."
