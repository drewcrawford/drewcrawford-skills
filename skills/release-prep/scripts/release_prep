#!/usr/bin/env python3
"""Run the mechanical half of release prep and report what still needs judgment.

Most of a release checklist is not a judgment call: a grep, an exit code, or a
path that does or does not exist decides it. Those checks belong here, where
they cost seconds and can be re-run for free, rather than in an agent that
spends tens of thousands of tokens rediscovering how to run `grep`.

What is left over genuinely needs a model, so each check that cannot decide on
its own emits a prompt naming the work instead of guessing. A check earns that
prompt: asking on every run regardless of state is not a judgment call, it is a
reminder, and a reminder that cannot be answered is one a reader learns to skip
past. So an ask fires on evidence — a changelog with no section for the version
being released, a public API that moved since the last tag, a commit no remote
has seen — and the work that answers it is what makes it stop.

Exit status is 0 when nothing needs attention and 1 when something does, so
this doubles as a gate.
"""

import argparse
import json
import os
import re
import subprocess
import sys
from datetime import date
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent.parent
BUNDLED = SKILL_DIR / "scripts"

PASS, FAIL, JUDGMENT, SKIP = "pass", "fail", "judgment", "skip"

# Editions map to the oldest toolchain that can build them, except that no
# toolchain older than 1.49 is published for aarch64-apple-darwin — so the
# pre-2021 rows carry that floor rather than their true one, and `cargo msrv`
# has somewhere to start bisecting from.
EDITION_FLOOR = {"2015": "1.49", "2018": "1.49", "2021": "1.56", "2024": "1.85"}
REQUIRED_EDITION = "2024"

# Extensions that a browser plays rather than draws. GitHub will not render one
# through markdown image syntax, so the two sides of a doc carry different files.
VIDEO_EXT = {".mp4", ".webm", ".mov"}


class Finding:
    """One check's verdict, plus enough context to act on it."""

    def __init__(self, check, status, summary, detail=None, prompt=None, fix=None):
        self.check = check
        self.status = status
        self.summary = summary
        self.detail = detail or []
        self.prompt = prompt
        self.fix = fix

    def as_dict(self):
        return {
            "check": self.check,
            "status": self.status,
            "summary": self.summary,
            "detail": self.detail,
            "prompt": self.prompt,
            "fix": self.fix,
        }


class Ctx:
    """Everything the checks share: the repo, its cargo metadata, and options."""

    def __init__(self, root, args):
        self.root = root
        self.args = args
        self._metadata = None

    @property
    def metadata(self):
        if self._metadata is None:
            out = run(["cargo", "metadata", "--no-deps", "--format-version", "1"], self.root)
            self._metadata = json.loads(out.stdout) if out.returncode == 0 else {"packages": []}
        return self._metadata

    @property
    def packages(self):
        return self.metadata.get("packages", [])

    def publishable(self):
        """Packages that will actually be uploaded (`publish = false` opts out)."""
        return [p for p in self.packages if p.get("publish") != []]

    def rust_files(self):
        for path in sorted(self.root.rglob("*.rs")):
            if any(part in ("target", ".git") for part in path.parts):
                continue
            yield path

    def workspace_rust_files(self):
        """Only the source of packages cargo actually knows about.

        Examples and detached shim workspaces are excluded from the metadata, so
        this is what ships — which is the right scope for anything that judges
        the released artifact rather than the repository.
        """
        roots = [Path(p["manifest_path"]).parent for p in self.packages]
        for path in self.rust_files():
            if not any(str(path).startswith(str(r) + os.sep) for r in roots):
                continue
            # A `#[cfg(test)]` module and an integration test are not part of
            # the documented surface.
            if path.name in ("tests.rs", "build.rs") or "tests" in path.parts:
                continue
            yield path

    def repo_slug(self):
        """`owner/name` from the manifest's repository field, if it is a GitHub URL."""
        for pkg in self.packages:
            repo = pkg.get("repository") or ""
            m = re.match(r"https://github\.com/([^/]+)/([^/.]+)", repo)
            if m:
                return m.group(1), m.group(2)
        return None


def run(cmd, cwd, timeout=None):
    return subprocess.run(cmd, cwd=str(cwd), capture_output=True, text=True, timeout=timeout)


def git(args, root):
    return run(["git"] + args, root)


# --------------------------------------------------------------------------
# Repository hygiene
# --------------------------------------------------------------------------


def check_line_count(ctx):
    out = run([str(BUNDLED / "line_count"), str(ctx.root), "--format", "json"], ctx.root)
    if out.returncode not in (0, 1):
        return Finding("line-count", SKIP, "line_count did not run", [out.stderr.strip()])
    try:
        data = json.loads(out.stdout)
    except json.JSONDecodeError:
        return Finding("line-count", SKIP, "line_count emitted no JSON")
    over = data.get("findings", [])
    if not over:
        return Finding("line-count", PASS, f"{data.get('files', 0)} files, none oversized")
    return Finding(
        "line-count",
        FAIL,
        f"{len(over)} file(s) over the line threshold",
        [f"{f['path']}: {f['lines']} lines ({f['severity']})" for f in over],
        prompt=(
            "Split these files into focused modules. Preserve behavior; this is a "
            "refactor, not a rewrite. Use Rust 2018 module syntax (no mod.rs)."
        ),
    )


def check_agents_symlink(ctx):
    script = BUNDLED / "11_ensure_agents_symlink"
    out = run([str(script)], ctx.root)
    text = (out.stdout + out.stderr).strip()
    if out.returncode != 0:
        return Finding("agents-symlink", FAIL, "AGENTS.md is missing", text.splitlines())
    edited = "EDITS MADE: yes" in text
    return Finding(
        "agents-symlink",
        PASS,
        "CLAUDE.md -> AGENTS.md" + (" (created)" if edited else ""),
    )


def check_edition(ctx):
    wrong = [
        f"{p['name']}: edition {p.get('edition')}"
        for p in ctx.packages
        if p.get("edition") != REQUIRED_EDITION
    ]
    if wrong:
        return Finding(
            "edition",
            FAIL,
            f"{len(wrong)} package(s) not on edition {REQUIRED_EDITION}",
            wrong,
            prompt=(
                f"Move these packages to edition {REQUIRED_EDITION}, then fix the "
                "warnings the new edition introduces and re-run the gate."
            ),
        )
    return Finding("edition", PASS, f"all {len(ctx.packages)} packages on edition {REQUIRED_EDITION}")


def check_license_headers(ctx):
    missing = [
        str(p.relative_to(ctx.root))
        for p in ctx.rust_files()
        if not p.read_text(encoding="utf-8", errors="replace").lstrip().startswith("// SPDX-License-Identifier:")
    ]
    stale = []
    year = str(date.today().year)
    for name in ("NOTICE", "LICENSE", "LICENSE-MIT.md", "LICENSE-MIT", "README.md"):
        path = ctx.root / name
        if not path.is_file():
            continue
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            if "copyright" not in line.lower() or "[yyyy]" in line.lower():
                continue
            years = re.findall(r"\b(19|20)\d{2}\b", line)
            if years and year not in re.findall(r"\b((?:19|20)\d{2})\b", line):
                stale.append(f"{name}: {line.strip()}")
    detail = [f"missing SPDX: {m}" for m in missing] + [f"stale year: {s}" for s in stale]
    if not detail:
        return Finding("license-headers", PASS, "SPDX headers present, copyright current")
    return Finding(
        "license-headers",
        FAIL,
        f"{len(missing)} file(s) without SPDX, {len(stale)} stale copyright line(s)",
        detail,
        fix=f"{BUNDLED / 'spdx'} --apply" if missing else None,
        prompt=(
            f"Add the missing SPDX headers (run the fix command) and update copyright "
            f"years to {year}."
            if stale
            else None
        ),
    )


def check_ci_template(ctx):
    """Is this workflow the current generation of the template, plus whatever the project needs?

    Byte equality was the wrong question. The template says so itself — raise
    the timeout in the project that needs it, keep the extra matrix entries —
    and a project that installs a sibling tool the template never heard of is
    doing exactly what the template intends. Comparing bytes made every such
    project ask forever, which trains a reader to stop looking.

    Three questions are actually being asked, and only the first two have
    mechanical answers:

    - Is this the current *generation*? The `# matrix vN` marker answers it.
      Bumping the marker is the assertion that someone merged this generation
      forward; nothing else in the file can carry that claim.
    - Does the workflow still carry what the template mandates — the same
      steps, the same job-level keys? Names and keys answer it. Values do not:
      the template tells projects to raise `timeout-minutes`, so comparing the
      number would punish following the instructions.
    - Does it add anything of its own? Always allowed, so never a defect —
      reported only so the difference stays visible.
    """
    workflow = ctx.root / ".github" / "workflows" / "ci.yaml"
    if not workflow.is_file():
        workflow = ctx.root / ".github" / "workflows" / "ci.yml"
    template = SKILL_DIR / "templates" / "ci.yml"
    if not workflow.is_file():
        return Finding("ci-template", FAIL, "no .github/workflows/ci.yaml", prompt=f"Copy {template} into place.")
    have, want = workflow.read_text(), template.read_text()
    mine, theirs = workflow_shape(have), workflow_shape(want)

    if mine.marker != theirs.marker:
        import difflib

        diff = list(difflib.unified_diff(want.splitlines(), have.splitlines(), "template", str(workflow), lineterm="", n=2))
        return Finding(
            "ci-template",
            JUDGMENT,
            f"workflow is {mine.marker}, template is {theirs.marker}",
            diff[:60],
            prompt=(
                f"Merge {template} forward into {workflow}, preserving every step and "
                "matrix entry the project added — the template is a starting point, not "
                f"an overwrite. Then set the marker on line 1 to `# {theirs.marker}`, "
                "which is what records that this generation was reconciled."
            ),
        )

    missing = [f"step: {s}" for s in theirs.steps if s not in mine.steps]
    missing += [f"key: {k}" for k in theirs.keys if k not in mine.keys]
    if missing:
        return Finding(
            "ci-template",
            FAIL,
            f"claims {mine.marker} but {len(missing)} template item(s) are absent",
            missing,
            prompt=(
                f"Either restore these from {template}, or — if the project dropped them "
                "deliberately — say so, because the marker currently claims a generation "
                "this workflow does not carry."
            ),
        )

    extra = [s for s in mine.steps if s not in theirs.steps]
    summary = f"{mine.marker}, every template step present"
    if extra:
        summary += f", plus {len(extra)} project step(s): {', '.join(extra)}"
    return Finding("ci-template", PASS, summary)


class Shape:
    """The parts of a CI workflow the template governs."""

    def __init__(self, marker, keys, steps):
        self.marker = marker
        self.keys = keys
        self.steps = steps


def workflow_shape(text):
    lines = text.splitlines()
    # A generation marker, not just any leading comment: a fork of somebody
    # else's workflow opens with a paragraph, and calling that a version makes
    # the report unreadable.
    first = re.match(r"#\s*(\w+ v\d+)\s*$", lines[0]) if lines else None
    marker = first.group(1) if first else "unversioned"
    keys, steps = [], []
    # The matrix is the one part of the preamble the template hands to the
    # project outright ("other items may be listed here as well"), so its
    # contents are skipped rather than compared.
    skip_below = None
    step_indent = None
    in_steps = False
    for line in lines[1:]:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indent = len(line) - len(line.lstrip())
        if in_steps:
            m = re.match(r"-\s+(?:name|uses):\s*(.+)", stripped)
            # Only at the step's own indent: a `run:` body may contain
            # anything, including something that looks like a list item.
            if m and step_indent in (None, indent):
                step_indent = indent
                steps.append(m.group(1).strip())
            continue
        if skip_below is not None:
            if indent > skip_below:
                continue
            skip_below = None
        if stripped == "steps:":
            in_steps = True
            continue
        key = stripped.split(":")[0].strip()
        if key:
            keys.append(key)
        if stripped == "strategy:":
            skip_below = indent
    return Shape(marker, keys, steps)


# --------------------------------------------------------------------------
# Dependencies and publishability
# --------------------------------------------------------------------------


def check_dependencies(ctx):
    problems = []
    for pkg in ctx.packages:
        for dep in pkg.get("dependencies", []):
            where = f"{pkg['name']} -> {dep['name']}"
            if dep.get("source") and "git+" in str(dep.get("source")):
                problems.append(f"{where}: git dependency")
            path = dep.get("path")
            if path and not str(path).startswith(str(ctx.root)):
                problems.append(f"{where}: path outside the workspace ({path})")
            # A dev-dependency may name only a path: cargo drops it when
            # publishing, which is what lets a crate dev-depend on something
            # that depends back on it. A normal one may not.
            if path and dep.get("req") == "*" and dep.get("kind") is None:
                problems.append(f"{where}: path dependency with no version requirement")
    if problems:
        return Finding(
            "dependencies",
            FAIL,
            f"{len(problems)} dependency problem(s)",
            problems,
            prompt=(
                "Fix these before publishing. A path dependency with no version cannot "
                "be packaged: declare it in [workspace.dependencies] with both a path "
                "and a version, and have members inherit it with `workspace = true`. "
                "Leave dev-dependencies that point back at a dependent crate bare — "
                "versioning those creates a cycle with no publishable order."
            ),
        )
    return Finding("dependencies", PASS, "no git, external-path, or unversioned dependencies")


def check_package(ctx):
    """Actually try to package. A checklist that never attempts the release has a hole."""
    broken = []
    for pkg in ctx.publishable():
        out = run(
            ["cargo", "package", "-p", pkg["name"], "--no-verify", "--allow-dirty", "--quiet"],
            ctx.root,
            timeout=600,
        )
        if out.returncode == 0:
            continue
        err = out.stderr
        # Downstream crates cannot package until their siblings are actually on
        # the registry. That is publish order, not a defect.
        if "no matching package named" in err and "crates.io index" in err:
            continue
        first = next((l.strip() for l in err.splitlines() if l.strip().startswith("error")), err.strip()[:200])
        broken.append(f"{pkg['name']}: {first}")
    if broken:
        return Finding(
            "package",
            FAIL,
            f"{len(broken)} crate(s) cannot be packaged",
            broken,
            prompt="Resolve these packaging errors; each one blocks `cargo publish`.",
        )
    return Finding("package", PASS, f"{len(ctx.publishable())} crate(s) package cleanly")


def check_version(ctx):
    """Is this version number right, given what is already on crates.io?"""
    state = {p["name"]: crates_io_versions(p["name"]) for p in ctx.publishable()}
    unknown = [n for n, (s, _) in state.items() if s == "unknown"]
    if unknown:
        return Finding("version", SKIP, f"could not reach crates.io for {len(unknown)} crate(s)", unknown)

    slug = ctx.repo_slug()
    ours = f"github.com/{slug[0]}/{slug[1]}" if slug else None
    # A name that exists on crates.io is not necessarily *your* crate. Comparing
    # the published repository against this one separates "we have released
    # before" from "this name belongs to somebody else", which are opposite
    # problems: one needs a version bump, the other needs a rename.
    taken = [
        f"{n}: crates.io/{n} belongs to {info['repository'] or 'an unknown repository'}"
        for n, (s, info) in state.items()
        if s == "published" and ours and ours not in (info["repository"] or "")
    ]
    if taken:
        return Finding(
            "version",
            FAIL,
            f"{len(taken)} crate name(s) already belong to someone else",
            taken,
            prompt=(
                "These names are taken on crates.io by an unrelated project, so "
                "`cargo publish` will be rejected. Either rename the crate, or set "
                "`publish = false` if it was never meant to be released."
            ),
        )
    if all(s == "absent" for s, _ in state.values()):
        return Finding(
            "version",
            PASS,
            f"never published; {ctx.packages[0]['version'] if ctx.packages else '?'} is a first release",
        )
    # Three separate questions, all answerable. Is the local version behind what
    # is published: always wrong. Is it the same: wrong only if there is
    # something to release, since a repository sitting at its published version
    # with nothing new is a repository between releases, not a defect. Is the
    # bump big enough: `cargo semver-checks` exists to answer exactly that, and
    # asking a model to run it and read the output is asking it to be a shell.
    lower, same = [], []
    for n, (s, info) in state.items():
        if s != "published":
            continue
        local, published = version_tuple(ver(ctx, n)), version_tuple(info["version"])
        where = f"{n}: local {ver(ctx, n)}, crates.io {info['version']}"
        if local < published:
            lower.append(where)
        elif local == published:
            same.append(where)
    tag = newest_tag(ctx)
    unreleased = git(["log", "--oneline", f"{tag}..HEAD" if tag else "HEAD"], ctx.root).stdout.split("\n")
    unreleased = [c for c in unreleased if c.strip()]
    if lower or (same and unreleased):
        since = f"{len(unreleased)} commit(s) since {tag}" if tag else "no release tag to measure against"
        return Finding(
            "version",
            FAIL,
            f"{len(lower) + len(same)} crate(s) not bumped past what is published",
            lower + same + [since],
            prompt=(
                "Bump the version in Cargo.toml, in [workspace.dependencies] if one is "
                "declared there, and in the CHANGELOG heading. `cargo publish` rejects a "
                "version that already exists."
            ),
        )
    if same:
        return Finding("version", PASS, f"nothing to release; {len(same)} crate(s) match crates.io", same)
    ahead = [
        f"{n}: {ver(ctx, n)} over {info['version']}" for n, (s, info) in state.items() if s == "published"
    ]
    if not ctx.args.slow:
        return Finding("version", PASS, f"{len(ahead)} crate(s) bumped past crates.io", ahead)
    if run(["cargo", "semver-checks", "--version"], ctx.root).returncode != 0:
        return Finding(
            "version",
            PASS,
            f"{len(ahead)} crate(s) bumped; cargo-semver-checks is not installed, so the bump size is unverified",
            ahead + ["cargo install cargo-semver-checks"],
        )
    out = run(["cargo", "semver-checks"], ctx.root, timeout=3600)
    if out.returncode == 0:
        return Finding("version", PASS, "bumped, and cargo semver-checks accepts the bump", ahead)
    text = out.stdout + out.stderr
    # A non-zero exit is not by itself a verdict. cargo-semver-checks reads
    # rustdoc's JSON, whose format is versioned and moves with the toolchain, so
    # a tool a few releases behind the compiler exits non-zero having checked
    # nothing. Reporting that as "your bump is too small" sends someone to
    # change a version number over a stale binary.
    if "semver requires new" not in text:
        return Finding(
            "version",
            PASS,
            f"{len(ahead)} crate(s) bumped; cargo semver-checks did not complete, so the bump size is unverified",
            ahead + ["cargo semver-checks did not complete:"] + text.strip().splitlines()[-6:],
        )
    return Finding(
        "version",
        FAIL,
        "cargo semver-checks rejects the bump",
        text.strip().splitlines()[-20:],
        prompt=(
            "The listed changes require a larger bump than the one taken: bump the major "
            "component (0.1.0 -> 0.2.0, 1.0.0 -> 2.0.0) rather than the minor, and update "
            "the CHANGELOG heading to match. If a change is not meant to be breaking, the "
            "other repair is to put back what was removed."
        ),
    )


def version_tuple(v):
    """Comparable form of a version. A pre-release suffix sorts below its release."""
    core, _, pre = str(v).partition("-")
    parts = [int(p) if p.isdigit() else 0 for p in core.split(".")]
    while len(parts) < 3:
        parts.append(0)
    return (*parts[:3], 0 if pre else 1)


def ver(ctx, name):
    for p in ctx.packages:
        if p["name"] == name:
            return p["version"]
    return "?"


def crates_io_versions(name):
    """Ask the sparse index whether a crate exists, and for which versions.

    Returns ("published", [versions]), ("absent", []) or ("unknown", []).

    The third case matters more than it looks. Treating an unreachable index as
    "never published" would silently green-light a first-release version number
    for a crate that has shipped ten times — a wrong answer produced by a
    network error, which is the failure mode this whole tool exists to avoid.
    So it is reported as unknown rather than folded into either verdict.
    """
    # curl rather than urllib: the interpreter shipped with macOS has no CA
    # bundle wired up, so urllib fails to verify *every* certificate. crates.io
    # wants a User-Agent that identifies the caller.
    out = run(
        [
            "curl", "-sS", "-o", "-", "-w", "\n%{http_code}", "--max-time", "20",
            "-H", "User-Agent: release-prep (https://github.com/drewcrawford/skills)",
            f"https://crates.io/api/v1/crates/{name}",
        ],
        Path.cwd(),
    )
    if out.returncode != 0:
        return "unknown", None
    body, _, code = out.stdout.rpartition("\n")
    if code.strip() == "404":
        return "absent", None
    if code.strip() != "200":
        return "unknown", None
    try:
        crate = json.loads(body)["crate"]
        return "published", {"version": crate.get("max_version"), "repository": crate.get("repository") or ""}
    except (ValueError, KeyError):
        return "unknown", None


def minor_version(v):
    parts = v.split(".")
    return tuple(parts[:2])


def check_msrv(ctx):
    declared = {p.get("rust_version") for p in ctx.packages if p.get("rust_version")}
    if not declared:
        return Finding("msrv", FAIL, "no rust-version declared", prompt="Declare rust-version in [workspace.package].")
    editions = {p.get("edition") for p in ctx.packages}
    floor = max((EDITION_FLOOR.get(e, "1.85") for e in editions), key=lambda v: tuple(map(int, v.split("."))))
    if not ctx.args.slow:
        return Finding("msrv", SKIP, f"declared {sorted(declared)}; re-run with --slow to verify")
    if run(["cargo", "msrv", "--version"], ctx.root).returncode != 0:
        return Finding("msrv", SKIP, "cargo-msrv is not installed", ["cargo install cargo-msrv"])
    # The default human format colours the result even when piped, so the version
    # arrives wrapped in ANSI escapes that a plain regex reads straight past.
    # `minimal` prints the bare version and is the format meant to be parsed.
    out = run(["cargo", "msrv", "find", "--min", floor, "--output-format", "minimal"], ctx.root, timeout=3600)
    found = re.search(r"^(\d+\.\d+(?:\.\d+)?)$", out.stdout.strip())
    if not found:
        return Finding(
            "msrv",
            SKIP,
            f"cargo msrv reported no MSRV at or above {floor}",
            (out.stdout + out.stderr).strip().splitlines()[-5:],
            prompt=f"Run `cargo msrv find --min {floor}` to see which compatibility check failed.",
        )
    detected = found.group(1)
    # cargo-msrv only tries the newest patch of each minor, so it can report
    # 1.85.1 for a crate that builds fine on 1.85.0. Minor is the finest
    # granularity the detection actually distinguishes.
    if len(declared) == 1 and minor_version(next(iter(declared))) == minor_version(detected):
        return Finding("msrv", PASS, f"declared {sorted(declared)[0]} matches detected {detected}")
    return Finding(
        "msrv",
        FAIL,
        f"detected {detected}, declared {sorted(declared)}",
        prompt=f"Set rust-version to {detected} everywhere it is declared.",
    )


# --------------------------------------------------------------------------
# Documentation
# --------------------------------------------------------------------------


def crate_doc(path):
    """The crate-level doc comment, in either `//!` or `/*! */` form."""
    return crate_doc_text(path.read_text(encoding="utf-8", errors="replace"))


def crate_doc_text(text):
    lines = text.splitlines()
    out, started = [], False
    for line in lines:
        if line.startswith("//!"):
            started = True
            out.append(line[4:] if line.startswith("//! ") else line[3:])
        elif started and line.strip() and not line.startswith("//"):
            break
    if out:
        return out
    block = re.search(r"/\*!(.*?)\*/", text, re.S)
    return block.group(1).splitlines() if block else []


def check_docs_presence(ctx):
    """Missing module headers, plus whatever rustdoc's own lints catch.

    The two halves are different kinds of verdict and are reported as such.
    Rustdoc rejecting the build is decided — an undocumented public item, a
    link resolving to nothing, a fence annotated `ignroe` — and reads as a
    defect with a line number. A module with no `//!` header needs somebody to
    read the module and write one, which no exit code can do.
    """
    bare = []
    for path in ctx.workspace_rust_files():
        # Scan a generous window rather than the first few lines: inner
        # attributes such as a multi-line `#![cfg_attr(...)]` legitimately sit
        # above the header.
        head = path.read_text(encoding="utf-8", errors="replace").splitlines()[:60]
        if not any(l.startswith("//!") or l.lstrip().startswith("/*!") for l in head):
            bare.append(str(path.relative_to(ctx.root)))
    out = run([str(BUNDLED / "check_docs")], ctx.root, timeout=1800) if ctx.args.slow else None
    if out is not None and out.returncode != 0:
        errors = rustdoc_errors(out.stdout + out.stderr)
        return Finding(
            "docs-presence",
            FAIL,
            f"rustdoc rejected the documentation ({len(errors) or 'see below'} error(s))",
            errors or (out.stdout + out.stderr).strip().splitlines()[-10:],
            prompt=(
                "Fix each of these where rustdoc points. A link that resolves to nothing "
                "is a doc describing an API that moved; correct the prose to match what "
                "the item is called now rather than deleting the link."
            ),
        )
    if not bare:
        return Finding("docs-presence", PASS, "every module carries a header")
    return Finding(
        "docs-presence",
        JUDGMENT,
        f"{len(bare)} module(s) without a //! header",
        [f"no //! header: {b}" for b in bare],
        prompt=(
            "Write a `//!` header for each of these describing what the module actually "
            "does — read the implementation first; a header that restates the filename "
            "is worse than none. `-D missing_docs` does not reach private modules, "
            "which is why these were invisible."
        ),
    )


def rustdoc_errors(text):
    """Each `error:` with the `-->` location under it, which is the actionable pair."""
    lines = text.splitlines()
    out = []
    for i, line in enumerate(lines):
        if not line.startswith("error"):
            continue
        where = next((l.strip() for l in lines[i + 1 : i + 4] if l.strip().startswith("-->")), None)
        out.append(f"{line.strip()} {where}" if where else line.strip())
    return out[:20]


def check_docs_assets(ctx):
    """Asset references in crate docs must be absolute and must exist.

    A relative path resolves against the local `target/doc` tree and against
    nothing at all on docs.rs, so it renders while you are testing it and 404s
    for everyone else. An absolute URL is correct but can still name a file that
    was renamed or never existed, so the path component is checked too.
    """
    slug = ctx.repo_slug()
    problems = []
    for pkg in ctx.packages:
        lib = Path(pkg["manifest_path"]).parent / "src" / "lib.rs"
        if not lib.is_file():
            continue
        for line in crate_doc(lib):
            for alt, url in re.findall(r"!\[([^\]]*)\]\(([^)]+)\)", line):
                rel = str(lib.relative_to(ctx.root))
                if not url.startswith(("http://", "https://")):
                    problems.append(f"{rel}: relative asset '{url}' ({alt}) — breaks on docs.rs")
                    continue
                m = re.match(r"https://github\.com/([^/]+)/([^/]+)/raw/[^/]+/(.+)", url)
                if not m:
                    continue
                if slug and (m.group(1), m.group(2)) != slug:
                    problems.append(f"{rel}: asset points at {m.group(1)}/{m.group(2)}, not {slug[0]}/{slug[1]}")
                target = ctx.root / m.group(3)
                if not target.is_file():
                    problems.append(f"{rel}: asset '{m.group(3)}' does not exist in the repo")
                elif target.suffix.lower() in VIDEO_EXT:
                    problems.append(
                        f"{rel}: '{m.group(3)}' is video in markdown image syntax — "
                        "use <video src=... controls> so it plays"
                    )
    if problems:
        return Finding(
            "docs-assets",
            FAIL,
            f"{len(problems)} asset problem(s) in crate docs",
            problems,
            prompt=(
                "Rewrite each crate-doc asset reference as an absolute URL of the form "
                "https://github.com/<owner>/<repo>/raw/main/<path>, pointing at a file "
                "that exists. README keeps the repo-relative path; only the crate doc "
                "takes the absolute form. Video belongs in a <video> element, and its "
                "README counterpart is the .gif of the same name."
            ),
        )
    return Finding("docs-assets", PASS, "crate-doc assets are absolute and present")


def to_readme_form(lines, slug):
    """Render crate-doc markdown the way the README spells the same content."""
    owner_repo = f"{slug[0]}/{slug[1]}" if slug else r"[^/]+/[^/]+"
    # Reference-link definitions go first: the intra-doc rewrite below would
    # otherwise eat the brackets that identify them, leaving the URL stranded in
    # the text as though the README were missing a line.
    kept = [l for l in lines if not re.match(r"^\s*\[`?[^`\]]+`?\]:\s*\S+$", l)]
    out = []
    for line in kept:
        line = re.sub(rf"https://github\.com/{owner_repo}/raw/[^/]+/", "", line)
        line = re.sub(rf"https://github\.com/{owner_repo}/(?:blob|tree)/[^/]+/", "./", line)
        line = re.sub(r"\[(`[^`]+`)\]\(crate\)", r"\1", line)
        line = re.sub(r"\[(`[^`]+`)\](?!\()", r"\1", line)
        for ext in VIDEO_EXT:
            line = line.replace(ext, ".gif")
        out.append(line)
    return out


def canonical_blocks(lines):
    """Reflow to paragraph units so wrap width cannot masquerade as drift."""
    blocks, para, in_code = [], [], False
    # A wrapped list item continues on a plain line, so a bare paragraph line
    # directly beneath one belongs to it — otherwise wrap width alone splits a
    # bullet into two blocks and every re-wrap reads as drift.
    continuing_list = False

    def flush():
        nonlocal para
        if para:
            blocks.append(" ".join(para))
            para = []

    for raw in lines:
        line = raw.rstrip()
        if line.startswith("```"):
            flush()
            in_code = not in_code
            blocks.append("```rust" if line == "```" else line)
            continuing_list = False
            continue
        if in_code:
            blocks.append(line)
            continue
        if not line.strip():
            flush()
            continuing_list = False
            continue
        stripped = line.lstrip()
        # A marker needs whitespace after it. Without that test, a paragraph
        # opening with bold text — `**nightly + ...` — reads as a bullet, and
        # the block boundary it invents shows up as drift.
        is_bullet = bool(re.match(r"^(?:[*\-+>]|\d+\.)\s", stripped))
        if is_bullet or stripped[:1] in "|#":
            flush()
            blocks.append(" ".join(line.split()))
            continuing_list = is_bullet
            continue
        if continuing_list and not para:
            blocks[-1] += " " + " ".join(line.split())
            continue
        para.append(line.strip())
    flush()
    return [normalize_names(b) for b in blocks]


def normalize_names(block):
    """Collapse the ways the same item gets spelled on each side of the boundary.

    An attribute macro is `#[export]` in prose and `[`export`]` as an intra-doc
    link; a README qualifies it as `wasm_lite::export` where rustdoc, already
    inside the crate, does not; and a relative link is written with or without a
    leading `./`. None of those are differences of content.
    """
    block = re.sub(r"`#\[([^\]]+)\]`", r"`\1`", block)
    block = re.sub(r"`(?:\w+::)+(\w+!?)`", r"`\1`", block)
    block = re.sub(r"\]\(\./", "](", block)
    return block


def check_readme_sync(ctx):
    readme = ctx.root / "README.md"
    root_pkgs = [p for p in ctx.packages if (Path(p["manifest_path"]).parent / "src" / "lib.rs").is_file()]
    if not readme.is_file() or not root_pkgs:
        return Finding("readme-sync", SKIP, "no README.md or no lib.rs to compare")
    # The crate whose docs the README mirrors is the one named like the repo.
    slug = ctx.repo_slug()
    primary = next((p for p in root_pkgs if slug and p["name"].replace("-", "_") == slug[1].replace("-", "_")), root_pkgs[0])
    lib = Path(primary["manifest_path"]).parent / "src" / "lib.rs"
    generated = canonical_blocks(to_readme_form(crate_doc(lib), slug))
    actual = canonical_blocks(readme.read_text(encoding="utf-8", errors="replace").splitlines())
    import difflib

    diff = [l for l in difflib.unified_diff(generated, actual, f"from {lib.name}", "README.md", lineterm="", n=0)]
    if not diff:
        return Finding("readme-sync", PASS, f"README.md matches {primary['name']}'s crate docs")
    newer = more_recently_changed(ctx, lib, readme)
    guidance = {
        "lib": f"{lib} changed more recently, so README.md is stale: port the crate-doc changes into it.",
        "readme": (
            f"README.md changed more recently, so the edit landed on the wrong side: "
            f"port it back into {lib}, which is the source, then re-sync the README."
        ),
        None: "Both changed; reconcile them by hand.",
    }[newer]
    return Finding(
        "readme-sync",
        JUDGMENT,
        f"README.md and {lib.name} differ in {sum(1 for l in diff if l.startswith('@@'))} place(s)",
        diff[:60],
        prompt=(
            guidance + " Differences of link syntax, logo URL, wrap width, and "
            "`#[attr]` spelling are expected and already normalized away — everything "
            "listed above is real drift."
        ),
    )


def more_recently_changed(ctx, a, b):
    """Which of two files has the newer commit? None if they share one."""
    stamps = {}
    for key, path in (("lib", a), ("readme", b)):
        out = git(["log", "-1", "--format=%ct", "--", str(path)], ctx.root)
        stamps[key] = int(out.stdout.strip()) if out.stdout.strip().isdigit() else 0
    if stamps["lib"] == stamps["readme"]:
        return None
    return "lib" if stamps["lib"] > stamps["readme"] else "readme"


def check_doctests(ctx):
    """`no_run` and `ignore` need a stated reason, or nobody can tell if they still apply."""
    offenders = []
    pattern = re.compile(r"```[^\n`]*\b(no_run|ignore)\b")
    for path in ctx.rust_files():
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
        for i, line in enumerate(lines):
            m = pattern.search(line)
            if not m:
                continue
            window = " ".join(lines[i : i + 4])
            if f"{m.group(1)} because:" not in window:
                offenders.append(f"{path.relative_to(ctx.root)}:{i + 1}: {m.group(1)} without a reason")
    if offenders:
        return Finding(
            "doctests",
            FAIL,
            f"{len(offenders)} doctest(s) missing a justification",
            offenders,
            prompt=(
                "Add a hidden comment on the line after each fence explaining why it "
                "cannot run, e.g. `# // no_run because: needs a browser`. An `ignore` "
                "block that is not Rust at all (a diagram, a table) should say so."
            ),
        )
    return Finding("doctests", PASS, "annotated doctests all state a reason")


# --------------------------------------------------------------------------
# The gate, and the checks that only a model can settle
# --------------------------------------------------------------------------


def check_gate(ctx):
    script = ctx.root / "scripts" / "check_all"
    if not script.is_file():
        return Finding("gate", SKIP, "no scripts/check_all in this project")
    if not ctx.args.slow:
        return Finding("gate", SKIP, "re-run with --slow to run scripts/check_all")
    out = run([str(script)], ctx.root, timeout=7200)
    if out.returncode == 0:
        return Finding("gate", PASS, "scripts/check_all passed")
    tail = (out.stdout + out.stderr).strip().splitlines()[-25:]
    return Finding(
        "gate",
        FAIL,
        f"scripts/check_all failed ({out.returncode})",
        tail,
        prompt="Fix what the gate reports, then re-run it. Do not narrow the gate to make it pass.",
    )


def check_classification(ctx):
    """Are the crate classified and the repository tagged, and are the slugs real?

    Asking every release whether the categories are still the right ones gets
    the same answer every release, because the instruction is to change them
    only if the project has actually moved. What is worth asking mechanically
    is whether they are there and whether crates.io will accept them: an
    invented slug is not a matter of taste, it is a rejected `cargo publish`.
    """
    slugs = crates_io_category_slugs()
    problems = []
    for pkg in ctx.publishable():
        cats, words = pkg.get("categories") or [], pkg.get("keywords") or []
        if not cats:
            problems.append(f"{pkg['name']}: no categories")
        if len(cats) > 5:
            problems.append(f"{pkg['name']}: {len(cats)} categories, crates.io allows 5")
        if len(words) > 5:
            problems.append(f"{pkg['name']}: {len(words)} keywords, crates.io allows 5")
        if not words:
            problems.append(f"{pkg['name']}: no keywords")
        for c in cats if slugs else []:
            if c not in slugs:
                problems.append(f"{pkg['name']}: '{c}' is not a crates.io category")

    topics, note = github_topics(ctx)
    if topics is not None and not topics:
        problems.append("no GitHub topics")
    if problems:
        return Finding(
            "classification",
            FAIL,
            f"{len(problems)} classification problem(s)",
            problems,
            prompt=(
                "Categories come from https://crates.io/api/v1/category_slugs and an "
                "invented one is rejected at publish time. Topics are `gh repo edit "
                "--add-topic`. They answer the same question for two registries, so "
                "decide once and apply it in both."
            ),
        )
    counts = [f"{p['name']}: {len(p.get('categories') or [])} categories, {len(p.get('keywords') or [])} keywords" for p in ctx.publishable()]
    return Finding(
        "classification",
        PASS,
        f"categories valid, {len(topics) if topics is not None else 'unread'} GitHub topic(s)",
        counts + ([note] if note else []),
    )


_CATEGORY_SLUGS = []


def crates_io_category_slugs():
    """Every slug crates.io will accept, or None if it could not be asked."""
    if not _CATEGORY_SLUGS:
        out = run(
            [
                "curl", "-sS", "--max-time", "20",
                "-H", "User-Agent: release-prep (https://github.com/drewcrawford/skills)",
                "https://crates.io/api/v1/category_slugs",
            ],
            Path.cwd(),
        )
        try:
            _CATEGORY_SLUGS.append({c["slug"] for c in json.loads(out.stdout)["category_slugs"]})
        except (ValueError, KeyError, TypeError):
            _CATEGORY_SLUGS.append(None)
    return _CATEGORY_SLUGS[0]


def github_topics(ctx):
    """(topics, note). None when GitHub could not be asked, which is not a defect."""
    out = run(["gh", "repo", "view", "--json", "repositoryTopics"], ctx.root)
    if out.returncode != 0:
        return None, "GitHub topics unread: " + (out.stderr.strip().splitlines() or ["gh failed"])[0]
    try:
        return [t["name"] for t in json.loads(out.stdout).get("repositoryTopics") or []], None
    except ValueError:
        return None, "GitHub topics unread: gh returned no JSON"

TRAIT_PROMPT = (
    "Decide each of these. Then, for the types not listed, consider by hand whether "
    "Clone, Copy, PartialEq/Eq, Default, Display, From/Into, AsRef/AsMut, or "
    "Deref/DerefMut belong, and whether Send/Sync/!Unpin are worth guaranteeing — "
    "those depend on what the type means and cannot be decided mechanically. An "
    "exhaustive enum or a missing Hash may well be deliberate; if it is, say so in "
    "the type's documentation so the next audit does not re-litigate it."
)


def check_traits(ctx):
    """Flag what can be decided from the public API, and only ask about the rest.

    Reading several hundred API items to notice one missing `Debug` is exactly
    the work a model does poorly and a parser does perfectly — a previous audit
    of this kind reported that every public type implemented Debug while five
    did not.
    """
    if not ctx.args.slow:
        return Finding("traits", SKIP, "re-run with --slow to audit the public API")
    if run(["cargo", "public-api", "--version"], ctx.root).returncode != 0:
        return Finding("traits", SKIP, "cargo-public-api is not installed", ["cargo install cargo-public-api"])

    hard, soft = [], []
    for pkg in ctx.publishable():
        out = run(["cargo", "public-api", "-p", pkg["name"], "--omit", "blanket-impls"], ctx.root, timeout=1800)
        if out.returncode != 0:
            continue
        h, s = audit_api(pkg["name"], out.stdout.splitlines())
        hard += h
        soft += s
    if hard:
        return Finding("traits", FAIL, f"{len(hard)} public-API defect(s)", hard + soft, prompt=TRAIT_PROMPT)
    if soft:
        return Finding("traits", JUDGMENT, f"{len(soft)} type(s) to consider", soft, prompt=TRAIT_PROMPT)
    return Finding("traits", PASS, "no mechanical trait defects; a manual pass is still worthwhile")


def audit_api(crate, lines):
    """Split `cargo public-api` output into decided defects and open questions."""
    decls, impls, referenced = {}, {}, set()
    for line in lines:
        m = re.match(r"^(?:(#\[[^\]]+\]) )?pub (struct|enum|union|trait) ([\w:]+)", line)
        if m:
            decls[m.group(3)] = {"attrs": m.group(1) or "", "kind": m.group(2)}
            continue
        m = re.match(r"^impl(?:<[^>]*>)? ([\w:]+)(?:<[^>]*>)? for ([\w:]+)", line)
        if m:
            impls.setdefault(m.group(2), set()).add(m.group(1).split("::")[-1])
            continue
        if line.startswith("pub "):
            for groups in re.findall(r"\(([^)]*)\)|-> ([\w:]+)|: ([\w:]+)", line):
                for tok in re.findall(rf"{crate}::[\w:]+", " ".join(g for g in groups if g)):
                    referenced.add(tok)

    hard, soft = [], []
    for name, info in decls.items():
        traits = traits_for(name, impls)
        # A trait is not a value, so it has nothing to format.
        if info["kind"] != "trait" and "Debug" not in traits:
            hard.append(f"{name}: no Debug impl")
        if name.rsplit("::", 1)[-1].endswith("Error") and "Error" not in traits:
            hard.append(f"{name}: named like an error but does not implement Error")
        if info["kind"] == "enum" and "non_exhaustive" not in info["attrs"]:
            soft.append(f"{name}: public enum is not #[non_exhaustive] — deliberate?")
        if "Eq" in traits and "Hash" not in traits:
            soft.append(f"{name}: Eq without Hash, so it cannot key a map — deliberate?")
    declared_names = {leaf(d) for d in decls}
    for ref in sorted(referenced):
        # `Foo::Bar` is a variant of a declared type, not a type of its own.
        if leaf(ref) in declared_names or leaf(ref.rsplit("::", 1)[0]) in declared_names:
            continue
        hard.append(f"{ref}: reachable through the public API but never exported")
    return hard, soft


def leaf(path):
    return path.rsplit("::", 1)[-1]


def traits_for(name, impls):
    """Every trait implemented for a type, under any of the paths it appears at.

    `cargo public-api` prints a re-exported type's declaration at the exported
    path and its impls at the canonical one — and a type re-exported into two
    modules appears three times over. Matching on paths therefore reports
    re-exports as missing every trait they have, which is how this check first
    accused five perfectly well-behaved types of lacking `Debug`.

    Grouping by the last path segment resolves that. It conflates two distinct
    types that share a name in different modules, so a trait one of them
    implements is credited to both — a false negative. For a filter whose job
    is to narrow what a person reads, missing something beats crying wolf.
    """
    name = leaf(name)
    found = set()
    for path, implemented in impls.items():
        if leaf(path) == name:
            found |= implemented
    return found

def check_documentation(ctx):
    """Ask about the prose when the surface it describes has moved, and not otherwise.

    Whether documentation is *true* is not decidable, but whether there is
    anything new to be wrong about is. The public API at the last release tag,
    against the public API now, is that question — and when it comes back empty
    the docs describe the same surface they were last read against, so there is
    nothing to re-read. When it comes back with items, the ask names them
    instead of asking for the whole crate to be read again.

    Rustdoc's own lints cover the other half from underneath: a link to
    something that no longer exists fails `docs-presence` with a line number.
    """
    if not ctx.args.slow:
        return Finding("documentation", SKIP, "re-run with --slow to compare the public API against the last release")
    tag = newest_tag(ctx)
    if not tag:
        return Finding(
            "documentation",
            JUDGMENT,
            "no release tag to compare against; this is a first release",
            prompt=(
                "Read the crate-level docs once against the implementation. There is no "
                "published baseline, so nothing narrows this."
            ),
        )
    if run(["cargo", "public-api", "--version"], ctx.root).returncode != 0:
        return Finding("documentation", SKIP, "cargo-public-api is not installed", ["cargo install cargo-public-api"])
    out = run([str(BUNDLED / "compare_api.sh"), "--abbreviated"], ctx.root, timeout=3600)
    changed = [
        l for l in out.stdout.splitlines()
        if l[:1] in "+-" and not l.startswith(("+++", "---"))
    ]
    if not changed:
        return Finding("documentation", PASS, f"public API unchanged since {tag}")
    # An ask has to be answerable within the pass that raises it. Editing the
    # crate doc is the answer, and is visible; deciding the doc needs no change
    # is equally valid and leaves no trace at all, so an ask that only the first
    # can clear would stand for the whole release either way. Treat the crate
    # doc having been opened in this same window as the answer. It is weaker
    # than reading the prose — a logo URL corrected for `docs-assets` counts —
    # and it is the strongest signal that exists without inventing a file whose
    # only purpose is to record that somebody looked.
    if crate_doc_edited_since(ctx, tag):
        return Finding(
            "documentation",
            PASS,
            f"{len(changed)} public API item(s) changed since {tag}, and the crate docs were edited in the same window",
            changed[:40],
        )
    return Finding(
        "documentation",
        JUDGMENT,
        f"{len(changed)} public API item(s) changed since {tag}, and the crate docs were not touched",
        changed[:40],
        prompt=(
            "Check the crate-level docs against these items specifically: does the prose "
            "still describe what they do, and does it still name them correctly? Fix what "
            "has drifted; do not restyle what has not. `scripts/compare_docs.sh` shows the "
            "same comparison for doc text if the API diff is not enough to decide."
        ),
    )


def crate_doc_edited_since(ctx, tag):
    """Has any crate-level doc comment changed since `tag`?"""
    for pkg in ctx.publishable():
        lib = Path(pkg["manifest_path"]).parent / "src" / "lib.rs"
        if not lib.is_file():
            continue
        rel = str(lib.relative_to(ctx.root))
        was = git(["show", f"{tag}:{rel}"], ctx.root)
        if was.returncode != 0:
            return True  # the crate did not exist at the tag, so all of it is new
        if crate_doc_text(was.stdout) != crate_doc(lib):
            return True
    return False


def newest_tag(ctx):
    out = git(["tag", "--sort=-v:refname"], ctx.root)
    tags = [t for t in out.stdout.splitlines() if t.strip()]
    return tags[0] if tags else None


def check_changelog(ctx):
    """Is there a section for the version being released, with entries under it?

    Whether the entries are *good* needs a reader; whether they exist does not,
    and a release whose changelog still stops at the last version is the common
    failure by a wide margin.
    """
    path = ctx.root / "CHANGELOG.md"
    if not path.is_file():
        return Finding("changelog", FAIL, "no CHANGELOG.md", prompt="Use the `changelog` skill to start one.")
    text = path.read_text(encoding="utf-8", errors="replace")
    missing, empty, present = [], [], []
    for version in sorted({p["version"] for p in ctx.publishable()}):
        entries = changelog_entries(text, version)
        if entries is None:
            missing.append(version)
        elif not entries:
            empty.append(version)
        else:
            present.append(f"{version}: {len(entries)} entries")
    if missing or empty:
        return Finding(
            "changelog",
            FAIL,
            f"{len(missing)} version(s) with no section, {len(empty)} with an empty one",
            [f"no section: {v}" for v in missing] + [f"empty section: {v}" for v in empty],
            prompt=(
                "Use the `changelog` skill. Document every user-facing commit since the "
                "last release; omit pure refactors and CI chores. Match the file's "
                "existing voice."
            ),
        )
    return Finding("changelog", PASS, "every released version has a section", present)


def changelog_entries(text, version):
    """Bullet lines under `version`'s heading. None when it has no heading at all."""
    heading = re.compile(r"^(#{1,4})\s*\[?" + re.escape(version) + r"\]?(\s|$)")
    lines = text.splitlines()
    for i, line in enumerate(lines):
        m = heading.match(line)
        if not m:
            continue
        depth = len(m.group(1))
        entries = []
        for rest in lines[i + 1 :]:
            deeper = re.match(r"^(#{1,4})\s", rest)
            if deeper and len(deeper.group(1)) <= depth:
                break
            if rest.lstrip().startswith(("-", "*")):
                entries.append(rest.strip())
        return entries
    return None


def check_ci(ctx):
    """Is this exact commit pushed to every remote, and did its CI pass there?

    The step is an action rather than a reading, but its result is a fact both
    forges will state on request. Asking a model to push, poll, and report back
    means the answer lives in a conversation; asking the forge means the answer
    is in the report, with the run number that produced it.
    """
    if git(["status", "--porcelain"], ctx.root).stdout.strip():
        return Finding(
            "ci",
            JUDGMENT,
            "the tree is dirty, so there is nothing to confirm yet",
            prompt="Commit the outstanding work in logical units, then re-run this check.",
        )
    head = git(["rev-parse", "HEAD"], ctx.root).stdout.strip()
    remotes = [r for r in git(["remote"], ctx.root).stdout.split() if r]
    if not remotes:
        return Finding("ci", SKIP, "no git remotes")

    green, unpushed, failed, unknown = [], [], [], []
    for remote in remotes:
        url = git(["remote", "get-url", remote], ctx.root).stdout.strip()
        if not remote_has(ctx, remote, head):
            unpushed.append(f"{remote}: {head[:8]} is not on {url}")
            continue
        status, note = forge_run_status(ctx, remote, url, head)
        {"success": green, "failed": failed, "unknown": unknown}[status].append(f"{remote}: {note}")

    if failed:
        return Finding("ci", FAIL, f"CI failed on {len(failed)} remote(s)", failed + green,
                       prompt="Investigate the failure and report the cause. Do not fix it as part of this step.")
    if unpushed:
        return Finding("ci", JUDGMENT, f"{len(unpushed)} remote(s) without this commit", unpushed + green,
                       prompt="Push to each remote listed and wait for its CI — the `github` and `gitea` skills poll for you.")
    if unknown:
        return Finding("ci", JUDGMENT, f"{len(unknown)} remote(s) could not be confirmed", unknown + green,
                       prompt="Confirm these by hand with the `github` and `gitea` skills; the forge could not be asked here.")
    return Finding("ci", PASS, f"CI green on {len(green)} remote(s) for {head[:8]}", green)


def remote_has(ctx, remote, head):
    """Is this commit on the remote?

    `ls-remote` is the live answer but only names ref tips, so a commit that is
    an ancestor of one falls back to whatever the last fetch recorded.
    """
    out = git(["ls-remote", remote], ctx.root)
    if out.returncode == 0 and any(line.split()[:1] == [head] for line in out.stdout.splitlines()):
        return True
    return bool(git(["branch", "-r", "--contains", head, "--list", f"{remote}/*"], ctx.root).stdout.strip())


def forge_run_status(ctx, remote, url, head):
    """('success'|'failed'|'unknown', note) for this commit's newest run on a remote."""
    m = re.search(r"[:/]([^/:]+)/([^/]+?)(?:\.git)?$", url)
    if not m:
        return "unknown", f"cannot parse {url}"
    owner, repo = m.group(1), m.group(2)
    if "github.com" in url:
        out = run(["gh", "run", "list", "--repo", f"{owner}/{repo}", "--commit", head,
                   "--json", "databaseId,status,conclusion", "--limit", "20"], ctx.root)
        try:
            runs = json.loads(out.stdout)
        except ValueError:
            return "unknown", f"gh could not list runs ({(out.stderr.strip().splitlines() or [''])[0]})"
        return summarise_runs(runs, "databaseId")
    gitea = SKILL_DIR.parent / "gitea" / "scripts" / "gitea_builds.py"
    if not gitea.is_file():
        return "unknown", "the gitea skill is not installed alongside this one"
    if not os.environ.get("GITEA_URL") or not os.environ.get("GITEA_TOKEN"):
        return "unknown", "GITEA_URL/GITEA_TOKEN are not set"
    out = run([sys.executable, str(gitea), owner, repo, "--format", "json"], ctx.root, timeout=120)
    try:
        runs = [r for r in json.loads(out.stdout) if str(r.get("head_sha") or r.get("sha") or "") == head]
    except ValueError:
        return "unknown", f"gitea_builds.py returned no JSON ({(out.stderr.strip().splitlines() or [''])[0]})"
    return summarise_runs(runs, "id")


def summarise_runs(runs, id_key):
    if not runs:
        return "unknown", "no run for this commit"
    newest = runs[0]
    conclusion = (newest.get("conclusion") or newest.get("status") or "").lower()
    where = f"run {newest.get(id_key, '?')}"
    if conclusion in ("success", "completed"):
        return "success", f"{where} {conclusion}"
    if conclusion in ("failure", "failed", "cancelled", "timed_out", "startup_failure"):
        return "failed", f"{where} {conclusion}"
    return "unknown", f"{where} {conclusion or 'in progress'}"

# Order matters: cheap and structural first, then the things that edit files,
# then the gate — which has to run after the edits, not before them.
CHECKS = [
    ("line-count", check_line_count),
    ("agents-symlink", check_agents_symlink),
    ("edition", check_edition),
    ("dependencies", check_dependencies),
    ("doctests", check_doctests),
    ("license-headers", check_license_headers),
    ("docs-presence", check_docs_presence),
    ("docs-assets", check_docs_assets),
    ("readme-sync", check_readme_sync),
    ("documentation", check_documentation),
    ("traits", check_traits),
    ("ci-template", check_ci_template),
    ("classification", check_classification),
    ("msrv", check_msrv),
    ("package", check_package),
    ("version", check_version),
    ("changelog", check_changelog),
    ("gate", check_gate),
    ("ci", check_ci),
]

GLYPH = {PASS: "ok  ", FAIL: "FAIL", JUDGMENT: "ask ", SKIP: "skip"}


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("root", nargs="?", default=".", help="repository to inspect (default: cwd)")
    parser.add_argument("--only", action="append", metavar="CHECK", help="run just this check (repeatable)")
    parser.add_argument("--skip", action="append", metavar="CHECK", default=[], help="skip a check (repeatable)")
    parser.add_argument("--slow", action="store_true", help="also run the checks that build or bisect")
    parser.add_argument("--format", choices=("text", "json"), default="text")
    parser.add_argument("--list", action="store_true", help="list check names and exit")
    args = parser.parse_args(argv)

    if args.list:
        for name, _ in CHECKS:
            print(name)
        return 0

    root = Path(args.root).resolve()
    if not (root / ".git").exists():
        parser.error(f"not a git repository: {root}")
    known = {name for name, _ in CHECKS}
    for name in (args.only or []) + args.skip:
        if name not in known:
            parser.error(f"unknown check: {name}")

    ctx = Ctx(root, args)
    findings = []
    for name, fn in CHECKS:
        if args.only and name not in args.only:
            continue
        if name in args.skip:
            continue
        try:
            findings.append(fn(ctx))
        except subprocess.TimeoutExpired:
            findings.append(Finding(name, FAIL, "timed out"))
        except Exception as exc:  # a broken check must not hide the other findings
            findings.append(Finding(name, SKIP, f"check raised {type(exc).__name__}: {exc}"))

    if args.format == "json":
        print(json.dumps({"root": str(root), "findings": [f.as_dict() for f in findings]}, indent=2))
    else:
        report(findings)
    return 1 if any(f.status in (FAIL, JUDGMENT) for f in findings) else 0


def report(findings):
    for f in findings:
        print(f"[{GLYPH[f.status]}] {f.check}: {f.summary}")
    todo = [f for f in findings if f.status in (FAIL, JUDGMENT)]
    if not todo:
        print("\nNothing outstanding.")
        return
    for f in todo:
        print(f"\n--- {f.check} ({f.status}) ---")
        print(f.summary)
        for line in f.detail[:40]:
            print(f"  {line}")
        if len(f.detail) > 40:
            print(f"  ... and {len(f.detail) - 40} more")
        if f.fix:
            print(f"fix: {f.fix}")
        if f.prompt:
            print(f"prompt: {f.prompt}")


if __name__ == "__main__":
    sys.exit(main())
