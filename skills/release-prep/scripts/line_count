#!/usr/bin/env python3
"""Report oversized Rust source files."""

import argparse
import json
import sys
from pathlib import Path


def count_lines(path: Path) -> int:
    try:
        return sum(1 for line in path.read_text(encoding="utf-8").splitlines() if line.strip())
    except (UnicodeDecodeError, PermissionError, OSError):
        return 0


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description="Report non-empty line counts for Rust source files.")
    parser.add_argument("root", nargs="?", default=".", help="directory to inspect (default: cwd)")
    parser.add_argument("--warn", type=int, default=900, help="warning threshold (default: 900)")
    parser.add_argument("--severe", type=int, default=1500, help="failure threshold (default: 1500)")
    parser.add_argument("--format", choices=("text", "json"), default="text")
    args = parser.parse_args(argv)

    if args.warn < 1 or args.severe < args.warn:
        parser.error("thresholds must satisfy 1 <= --warn <= --severe")
    root = Path(args.root).resolve()
    if not root.is_dir():
        parser.error(f"root is not a directory: {root}")

    files = sorted(path for path in root.rglob("*.rs") if "target" not in path.parts)
    results = []
    for path in files:
        lines = count_lines(path)
        severity = "severe" if lines >= args.severe else "warning" if lines >= args.warn else "ok"
        results.append({"path": str(path.relative_to(root)), "lines": lines, "severity": severity})

    warnings = [result for result in results if result["severity"] == "warning"]
    severe = [result for result in results if result["severity"] == "severe"]
    report = {
        "root": str(root),
        "files": len(files),
        "total_nonempty_lines": sum(result["lines"] for result in results),
        "warning_threshold": args.warn,
        "severe_threshold": args.severe,
        "findings": warnings + severe,
    }

    if args.format == "json":
        print(json.dumps(report, indent=2))
    else:
        for result in warnings + severe:
            print(f"{result['severity'].upper()}: {result['path']} ({result['lines']} lines)")
        print(
            f"Checked {report['files']} Rust files; {len(warnings)} warning(s), "
            f"{len(severe)} severe finding(s)."
        )
    return 1 if severe else 0


if __name__ == "__main__":
    sys.exit(main())
